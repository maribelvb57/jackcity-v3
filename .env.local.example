NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Sign-in de Clerk. Cambia por ambiente:
#   local/dev: https://sharp-goblin-37.accounts.dev/sign-in
#   beta:      https://evolved-goose-57.accounts.dev/sign-in
#   prod:      https://accounts.jackcity.cl/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://sharp-goblin-37.accounts.dev/sign-in
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# URL pública del sitio. La usan el sitemap, el robots.txt, los canonical y los
# datos estructurados: sin ella todo apunta a http://localhost:3000.
#   prod: https://www.jackcity.cl
NEXT_PUBLIC_APP_URL=

# Ambiente de la app. Valores: dev | beta | prod (default dev si no se define).
# Es el interruptor de todo el tracking: GTM (con GA4 y Google Ads adentro) y
# el Meta Pixel se cargan sólo con 'prod', para que las pruebas en beta no
# generen eventos ni conversiones en las propiedades de producción.
NEXT_PUBLIC_APP_ENV=dev
